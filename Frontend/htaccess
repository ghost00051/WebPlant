ErrorDocument 404 "htaccess-OK"

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP_HOST} ^www\.checktheplants\.ru$ [NC]
    RewriteRule ^ https://checktheplants.ru%{REQUEST_URI} [R=301,L,NE]

    RewriteRule ^(login|register|home|add-plant|edit-profile|my-plants)/?$ $1.html [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>