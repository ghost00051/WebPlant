
ErrorDocument 404 /404.html

DirectoryIndex index.html

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|svg|webp|ico|woff2)$">
        Header set Cache-Control "public, max-age=15552000"
    </FilesMatch>
    <FilesMatch "\.(html|xml|txt|json)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    <FilesMatch "^(sw\.js)$">
        Header unset Expires
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>

    <FilesMatch "^(manifest\.json|manifest\.webmanifest)$">
        Header unset Expires
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    <If "%{REQUEST_URI} =~ m#^/admin/.*\.(js|css)$#">
        Header unset Expires
        Header set Cache-Control "no-cache, must-revalidate"
    </If>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"

    Header always set X-Frame-Options "DENY"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"

    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-8TCFlgyjvCLQm5xuJowlAqCrF9x9G/qL6uk94FKB7CY=' 'sha256-yK57jRshgXJfoUz8qpp58XOF6e137LQaSg73EDlPD0M=' 'sha256-W6O0yFhTO1iJRTKWkiN6mkM2t06DDeXh+nRA0OsbtbU=' 'sha256-dmZ/Fm2ZIRB4PSyVI1xBS76rk9gQBJ8IBKMuGVtwxIo=' https://www.googletagmanager.com https://mc.yandex.ru; script-src-attr 'unsafe-inline'; style-src 'self' 'sha256-UHT5dfpTr0hozo64wCPjdojAuId098ycH9daA+/fMzc=' 'sha256-NsC720X3WVoK11Y+/NnwVlsgwWbC5DxAQxM2K1w2Qh8=' 'sha256-OFdqm+lkMr9K4RnhSi24JA+3ZlwwbpBskPMZQ5uv6HY=' 'sha256-RxgO5VHTEwriHyE6EvJvxM7bTbuFwKKHtzUrskcOSQU=' 'sha256-LPDLYsKyNfLgz+o6bE14D5kzgc/QQV3AurzwxKOX3Ts='; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://server.checktheplants.ru https://mc.yandex.ru https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://server.checktheplants.ru https://region1.google-analytics.com https://www.google-analytics.com https://mc.yandex.ru https://yandex.ru; worker-src 'self' blob:; manifest-src 'self'; media-src 'self'; frame-src 'self' https://mc.yandex.ru https://yandex.ru; upgrade-insecure-requests"
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^\.(?!well-known)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/xml .xml
    AddType image/x-icon .ico
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP_HOST} ^www\.checktheplants\.ru$ [NC]
    RewriteRule ^ https://checktheplants.ru%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://checktheplants.ru%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{THE_REQUEST} ^\S+\s+/index\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L,NE]

    RewriteCond %{THE_REQUEST} ^[A-Z]+\s+/(login|register|home|add-plant|edit-profile|my-plants|reset-password|notifications)\.html[\s?] [NC]
    RewriteRule ^(login|register|home|add-plant|edit-profile|my-plants|reset-password|notifications)\.html$ /$1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} ^[A-Z]+\s+/(plants|care)\.html[\s?] [NC]
    RewriteRule ^(plants|care)\.html$ /$1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} ^[A-Z]+\s+/plants-[a-z0-9-]+\.html[\s?] [NC]
    RewriteRule ^plants-([a-z0-9-]+)\.html$ /plants/$1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} ^[A-Z]+\s+/care-[a-z0-9-]+\.html[\s?] [NC]
    RewriteRule ^care-([a-z0-9-]+)\.html$ /care/$1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} ^[A-Z]+\s+/(?!404\.html[\s?])[^?\s]*\.html[\s?] [NC]
    RewriteCond %{THE_REQUEST} !\s/(login|register|home|add-plant|edit-profile|my-plants|reset-password|notifications|plants|care|index)\.html[\s?] [NC]
    RewriteCond %{THE_REQUEST} !\s/(plants|care)-[a-z0-9-]+\.html[\s?] [NC]
    RewriteRule ^ - [R=404,L]

    RewriteRule ^(login|register|home|add-plant|edit-profile|my-plants|reset-password|notifications)/?$ $1.html [L]

    RewriteRule ^plants/?$ plants.html [L]
    RewriteRule ^care/?$ care.html [L]
    RewriteRule ^plants/([a-z0-9-]+)/?$ plants-$1.html [L]
    RewriteRule ^care/([a-z0-9-]+)/?$ care-$1.html [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^(plants|plants/[a-z0-9-]+|care|care/[a-z0-9-]+)/?$ index.html [L]

    RewriteRule ^ - [R=404,L]
</IfModule>
