{
  "name": "webplant",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-plant-images.mjs && node scripts/generate-seo-meta.mjs && vite build && node scripts/prerender.mjs && node scripts/build-manifest.mjs",
    "build:seo": "npm run build && npm run verify",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "check:seo-meta": "node scripts/generate-seo-meta.mjs --check",
    "check:seo": "node scripts/seo-check.mjs",
    "check:csp": "node scripts/check-security-headers.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "verify": "node scripts/verify-build.mjs && node scripts/verify-routing.mjs && node scripts/check-security-headers.mjs && node scripts/build-manifest.mjs --check && node scripts/seo-check.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:routing": "node scripts/verify-routing.mjs",
    "verify:security": "node scripts/check-security-headers.mjs",
    "verify:ui": "node scripts/verify-ui-stability.mjs",
    "verify:admin": "node scripts/admin-panel-smoke.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:dry": "node scripts/indexnow.mjs --dry-run",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.13.0",
    "vite": "^8.2.2"
  }
}
