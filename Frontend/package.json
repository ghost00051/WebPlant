{
  "name": "webplant",
  "private": true,
  "version": "1.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo-meta.mjs && vite build && node scripts/prerender.mjs",
    "build:seo": "npm run build && npm run verify",
    "check:seo-meta": "node scripts/generate-seo-meta.mjs --check",
    "verify": "node scripts/verify-build.mjs && node scripts/verify-routing.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:routing": "node scripts/verify-routing.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:dry": "node scripts/indexnow.mjs --dry-run",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "moment": "^2.31.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
