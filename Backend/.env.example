# WebPlant Backend — пример окружения.
# Скопируйте в .env и заполните значения. Файл .env в git не попадает.

# --- Основное ---
NODE_ENV=production
PORT=5000
APP_TIME_ZONE=Europe/Moscow
BACKGROUND_JOBS_ENABLED=true
DEPLOY_TARGET=compose

# --- База данных ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=WebPlant
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Пул соединений (см. Backend/db.js)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=15000
DB_POOL_IDLE_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000

# --- Секреты и сессии ---
# Сгенерируйте: openssl rand -base64 48   (минимум 32 байта, уникален для окружения)
SECRET_KEY=CHANGE_ME_32_BYTES_MINIMUM_RANDOM
# Домен cookie; для локальной разработки задайте AUTH_COOKIE_DOMAIN=none
AUTH_COOKIE_DOMAIN=.checktheplants.ru

# --- Origin'ы ---
FRONTEND_URL=https://checktheplants.ru
FRONTEND_ORIGIN=https://checktheplants.ru
ADMIN_PANEL_ORIGIN=https://admin.checktheplants.ru
# Временно: разрешить админ-API с основного сайта (старые панели рассылок в профиле).
# Ослабляет защиту B7.8 — включайте только на время миграции панелей на admin-поддомен.
ADMIN_PANEL_ALLOW_FRONTEND_ORIGIN=false
# Только для разработки: http://localhost:5173,http://127.0.0.1:5173
LOCAL_DEV_ORIGINS=
# Ссылка отписки в письмах. По умолчанию: ${FRONTEND_URL}/unsubscribe —
# этот путь должен проксироваться в backend /api/users/unsubscribe.
# Если прокси на фронтенде нет, укажите полный URL эндпоинта, например
# https://server.checktheplants.ru/api/users/unsubscribe
UNSUBSCRIBE_URL_BASE=

# --- WebAuthn / passkeys ---
RP_ID=checktheplants.ru
RP_NAME=Лейка
# true — требовать биометрию/PIN (user verification); false — только для старых ключей
PASSKEY_REQUIRE_USER_VERIFICATION=true

# --- Push (VAPID) ---
# Сгенерируйте: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@checktheplants.ru
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://default:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_KEY_PREFIX=ctp
REDIS_COMMAND_TIMEOUT_MS=500

# --- SMTP ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=checktheplants@mail.ru
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
MAIL_FROM=checktheplants@mail.ru
MAIL_REPLY_TO=checktheplants@mail.ru

# --- Yandex Cloud AI ---
YANDEX_CLOUD_FOLDER=CHANGE_ME_FOLDER_ID
YANDEX_CLOUD_API_KEY=CHANGE_ME_API_KEY
YANDEX_CLOUD_MODEL=deepseek-v4-flash/latest
YANDEX_CLOUD_VISION_MODEL=deepseek-v4.1-flash/latest
AI_DAILY_REQUEST_BUDGET=5000
AI_CHAT_TIMEOUT_MS=20000
AI_CHAT_DEADLINE_MS=25000
AI_ADVICE_TIMEOUT_MS=15000
AI_ADVICE_DEADLINE_MS=30000
# Должно быть меньше nginx proxy_read_timeout (60 с)
AI_VISION_TIMEOUT_MS=30000
AI_VISION_DEADLINE_MS=45000
AI_PRICE_INPUT_PER_1K=0.3
AI_PRICE_OUTPUT_PER_1K=0.5
AI_PRICE_CACHED_PER_1K=0.075

# --- Прочее ---
# Только для compose-стека: доступ к docker-socket-proxy
DOCKER_HOST=tcp://docker-socket-proxy:2375
DOCKER_STATS_ENABLED=true
PGADMIN_DEFAULT_EMAIL=admin@checktheplants.ru
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# --- Бэкапы ---
BACKUP_RETENTION_DAYS=14
# Необязательно: шифрование и выгрузка offsite (см. Backend/backup.sh)
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_OFFSITE_TARGET=
